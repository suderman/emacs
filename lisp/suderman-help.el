(defun suderman/cheatsheet-disable-meow ()
  "Keep the cheatsheet's own navigation and quit bindings active."
  (if (bound-and-true-p meow-mode)
      (meow-mode -1)
    (meow--disable)))

(define-derived-mode suderman/cheatsheet-mode special-mode "Cheatsheet"
  "Read a keyboard cheatsheet; quit returns to the invoking view."
  (setq-local truncate-lines t)
  (add-hook 'meow-mode-hook #'suderman/cheatsheet-disable-meow nil t)
  (suderman/cheatsheet-disable-meow))

(keymap-set suderman/cheatsheet-mode-map "SPC" #'meow-keypad)
(keymap-set suderman/cheatsheet-mode-map "h" #'quit-window)
(keymap-set suderman/cheatsheet-mode-map "<escape>" #'quit-window)
(keymap-set suderman/cheatsheet-mode-map "n" #'suderman/cheatsheet-next)
(keymap-set suderman/cheatsheet-mode-map "p" #'suderman/cheatsheet-previous)

(defun suderman/cheatsheet-command-label (command mode)
  "Return a readable label for COMMAND in MODE."
  (or (alist-get command suderman/cheatsheet-command-labels)
      (alist-get command meow-command-to-short-name-list)
      (when (and command (symbolp command))
        (let ((name (string-remove-prefix "suderman/" (symbol-name command)))
              (prefix (string-remove-suffix "-mode" (symbol-name mode))))
          (string-remove-prefix (concat prefix "-") name)))
      ""))

(defun suderman/cheatsheet-local-content ()
  "Render the current buffer's effective bindings as a keyboard sheet."
  (let ((mode major-mode)
        (title (pcase major-mode
                 ('notmuch-hello-mode "Mail overview")
                 ('notmuch-search-mode "Mail threads")
                 ('notmuch-tree-mode "Mail messages")
                 ('notmuch-show-mode "Read mail")
                 ('notmuch-message-mode "Compose mail")
                 (_ (capitalize
                     (string-replace "-" " "
                                     (string-remove-suffix "-mode" (symbol-name major-mode)))))))
        ;; Overview's search widget treats letters as input.  Show command keys
        ;; rather than a blank typing map, without changing the live field.
        (overriding-local-map (if (eq major-mode 'notmuch-hello-mode)
                                 (current-local-map)
                               overriding-local-map))
        (bindings (make-sparse-keymap))
        (keyboard-keys (apply #'append (mapcar #'cdr meow-cheatsheet-layout)))
        (suderman/cheatsheet-extra-keys
         (append suderman/cheatsheet-extra-keys
                 (when (eq major-mode 'notmuch-hello-mode)
                   '("<escape>"))
                 (when (memq major-mode '(notmuch-search-mode notmuch-tree-mode notmuch-show-mode))
                   '("C-v"))
                 (when (eq major-mode 'notmuch-show-mode)
                   '("C-c ."))
                 (when (eq major-mode 'notmuch-message-mode)
                   '("C-x C-s" "C-c C-p" "C-c C-c" "C-c C-s" "C-c C-a"
                     "C-c C-t" "C-c C-f s" "C-c C-b"))))
        labels extras notes)
    ;; Snapshot before entering the help buffer, including command remaps.
    (dolist (key (append keyboard-keys suderman/cheatsheet-extra-keys))
      (let* ((command (or (key-binding (kbd key)) 'undefined))
             (label (suderman/cheatsheet-command-label command mode)))
        (keymap-set bindings key command)
        (when (and (member key keyboard-keys) (not (assq command labels)))
          (let ((cell label))
            (when (> (string-width label) 9)
              (setq cell (format "[%d]" (1+ (length notes))))
              (push (cons cell label) notes))
            (push (cons command cell) labels)))
        (when (and (member key suderman/cheatsheet-extra-keys)
                   (not (string-empty-p label)))
          (push (format "%7s  %s" key label) extras))))
    (with-temp-buffer
      (let (;; Key lookup in a new GUI frame can use another keyboard's
            ;; terminal map.  The nonterminal override follows this render.
            (overriding-terminal-local-map nil)
            (overriding-local-map bindings)
            (meow-command-to-short-name-list labels))
        (insert title " cheatsheet\n" meow-cheatsheet-physical-layout)
        (meow--cheatsheet-replace-keysyms)
        (add-face-text-property (point-min) (point-max) 'meow-cheatsheet-command)
        (goto-char (point-max))
        (insert "\nOther keys\n")
        (dolist (row (seq-partition (nreverse extras) 3))
          (insert (mapconcat (lambda (entry) (format "%-44s" entry)) row "  ") "\n"))
        (when notes
          (insert "\nLabel notes\n")
          (dolist (note (nreverse notes))
            (insert (format "  %s  %s\n" (car note) (cdr note)))))
        (cond
         ((eq mode 'notmuch-message-mode)
          (insert "\nCompose uses Meow and meow-purrsist. i enters Insert; Escape returns to Normal.\n"
                  "Save keeps a local draft, not phone Drafts. Sending asks for confirmation.\n"
                  "M-x suderman/mail-draft-from-org builds a rich draft without sending.\n"))
         ((memq mode '(notmuch-hello-mode notmuch-search-mode notmuch-tree-mode notmuch-show-mode))
          (insert "\nSPC: keypad. ,: buffers. .: files. h: back. l: Return action. /: search/filter.\n"
                  "J: saved searches. i personal, w work, u unread, f stars, d local drafts, s Sent.\n"
                  "G fetches/syncs IMAP; wait for completion, then g refreshes.\n")
          (when (eq mode 'notmuch-hello-mode)
            (insert "Overview lists saved searches and folders. In its search field, letters type a query.\n"
                    "Escape leaves input unchanged and restores command keys. TAB moves between widgets.\n"
                    "This diagram shows overview commands, not the field's typing keys.\n"))
          (unless (eq mode 'notmuch-hello-mode)
            (insert "t r/u: read/unread. t f/F: star/unstar. Flags sync; folders organize mail.\n"
                    "a/x confirm single Inbox-copy moves. A/X and thread-row moves are disabled.\n"
                    "Moves sync with G. Trash follows provider retention rules.\n"))))
        (buffer-string)))))

(defun suderman/cheatsheet-view-content (view origin)
  "Render VIEW using ORIGIN, an open view, or its configured mode map."
  (if (eq view 'meow)
      (let ((existing (get-buffer "*Meow Cheatsheet*")))
        (unwind-protect
            (save-window-excursion
              (with-current-buffer origin (meow-cheatsheet))
              (with-current-buffer (window-buffer)
                (string-trim-left (buffer-string))))
          (unless existing
            (when-let* ((buffer (get-buffer "*Meow Cheatsheet*")))
              (kill-buffer buffer)))))
    (let ((source
           (seq-find (lambda (buffer)
                       (with-current-buffer buffer
                         (and (derived-mode-p view)
                              (or (eq view 'notmuch-message-mode)
                                  (not (bound-and-true-p meow-mode))))))
                     (cons origin (delq origin (buffer-list))))))
      (if source
          (with-current-buffer source (suderman/cheatsheet-local-content))
        ;; Reference sheets need keymaps, not live Agenda, explorer, or Git sessions.
        (pcase view
          ('org-agenda-mode (require 'org-agenda))
          ('ibuffer-mode (require 'ibuffer))
          ('dired-mode (require 'dirvish))
          ('magit-status-mode (require 'magit))
          ((or 'notmuch-hello-mode 'notmuch-search-mode 'notmuch-tree-mode
               'notmuch-show-mode 'notmuch-message-mode)
           (require 'notmuch)))
        (with-temp-buffer
          (setq major-mode view)
          (use-local-map (copy-keymap (symbol-value (intern (format "%s-map" view)))))
          (if (eq view 'notmuch-message-mode)
              (progn
                ;; Derived-mode inheritance is installed lazily on first compose.
                (set-keymap-parent (current-local-map) message-mode-map)
                (meow-mode 1))
            (suderman/cheatsheet-disable-meow))
          (when (eq view 'magit-status-mode)
            (suderman/magit-setup))
          (suderman/cheatsheet-local-content))))))

(defun suderman/cheatsheet-update ()
  "Replace the displayed keyboard sheet without changing its quit target."
  (let ((content (suderman/cheatsheet-view-content
                  suderman/cheatsheet-view suderman/cheatsheet-origin))
        (inhibit-read-only t))
    (erase-buffer)
    (insert content
            "\nC-c h: context cheatsheet. In keypad views, SPC ? does the same.\n"
            "SPC o opens Org commands where SPC invokes the Meow keypad.\n"
            "Other sheets use an open view or its configured mode map.\n"
            "After closing, C-h k describes a key; C-h m opens native mode help.\n")
    (goto-char (point-min))
    (forward-line 1)
    (insert "n/p: next/previous sheet. q, h, or Escape closes help.\n")
    (goto-char (point-min))))

(defun suderman/cheatsheet-cycle (step)
  "Move STEP sheets, wrapping at either end."
  (setq suderman/cheatsheet-view
        (nth (mod (+ (cl-position suderman/cheatsheet-view suderman/cheatsheet-views) step)
                  (length suderman/cheatsheet-views))
             suderman/cheatsheet-views))
  (suderman/cheatsheet-update))

(defun suderman/cheatsheet-next ()
  "Show the next keyboard sheet."
  (interactive)
  (suderman/cheatsheet-cycle 1))

(defun suderman/cheatsheet-previous ()
  "Show the previous keyboard sheet."
  (interactive)
  (suderman/cheatsheet-cycle -1))

;;;###autoload
(defun suderman/cheatsheet ()
  "Show the invoking view's keyboard bindings, with n/p sheet cycling."
  (interactive)
  (with-current-buffer (window-buffer (selected-window))
    (if (derived-mode-p 'suderman/cheatsheet-mode)
        (suderman/cheatsheet-update)
      (let* ((origin (current-buffer))
             (view (cond
                    ((derived-mode-p 'notmuch-message-mode) 'notmuch-message-mode)
                    ((bound-and-true-p meow-mode) 'meow)
                    (t (or (seq-find #'derived-mode-p (remq 'meow suderman/cheatsheet-views))
                           major-mode))))
             (views (if (memq view suderman/cheatsheet-views)
                        suderman/cheatsheet-views
                      (append suderman/cheatsheet-views (list view))))
             (buffer (get-buffer-create "*Keyboard Cheatsheet*")))
        (with-current-buffer buffer
          (suderman/cheatsheet-mode)
          (setq-local suderman/cheatsheet-origin origin
                      suderman/cheatsheet-view view
                      suderman/cheatsheet-views views)
          (suderman/cheatsheet-update))
        (pop-to-buffer buffer '(display-buffer-same-window))))))

