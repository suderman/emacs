  (append '(meow org-agenda-mode ibuffer-mode dired-mode magit-status-mode)
          (when (executable-find "notmuch")
            '(notmuch-hello-mode notmuch-search-mode notmuch-tree-mode
              notmuch-show-mode notmuch-message-mode)))
